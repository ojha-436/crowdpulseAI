# Firebase web configuration for the CrowdPulse frontend.
# Copy this file to `frontend/.env` and fill in the values from your Firebase
# project settings (Project settings → General → Your apps → SDK setup).
#
# These values are public identifiers (they ship in the browser bundle) — the
# real access control is enforced via Firebase Security Rules and by restricting
# the API key to your domains in the Google Cloud Console.
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id
