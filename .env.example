# Copy this file to .env and fill in your values.
# Every variable has a safe fallback for local runs, but JWT_SECRET and
# GEMINI_API_KEY MUST be set explicitly in any real deployment.

# --- AI (Google Gemini) ---
# API key for the Gemini API. When unset, the AI endpoints return a static
# fallback response instead of calling the model.
GEMINI_API_KEY=your_gemini_api_key_here
# Gemini model used for agent queries. Must support function calling.
GEMINI_MODEL=gemini-2.5-flash

# --- HTTP server ---
# Port the backend listens on.
PORT=8080

# --- Security ---
# Secret used to sign/verify JWTs. REQUIRED in production. If unset, an
# ephemeral per-process secret is generated and all tokens become invalid on
# every restart (a startup warning is logged).
JWT_SECRET=your_long_random_secret_here
# Comma-separated list of allowed CORS origins. Leave unset to allow any ("*").
ALLOWED_ORIGINS=http://localhost:5173

# --- Role-based access control ---
# Comma-separated allow-lists of the identities permitted to hold each privileged
# role. Elevation requires an explicit match (there is no "any Google account is
# admin" wildcard). Values shown are the built-in demo operators; override or
# clear them per deployment. Matching is case-insensitive.
PRIVILEGED_DIRECTOR_USERNAMES=abhiraj
PRIVILEGED_DIRECTOR_EMAILS=iamabhiraj8825@gmail.com
PRIVILEGED_SECURITY_USERNAMES=security_chief
PRIVILEGED_SECURITY_EMAILS=security@crowdpulse.ai

# --- Persistence (Firestore) ---
# Target GCP project for Firestore. When unset on Cloud Run, the project and
# credentials are auto-detected from the runtime service account.
GOOGLE_CLOUD_PROJECT=your_gcp_project_id_here

# --- Logging ---
# Minimum log level to emit: debug | info | warn | error (default: info).
LOG_LEVEL=info
